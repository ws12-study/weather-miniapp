/* pages/index/index.wxss · 云知天气样式（单位统一用 rpx，适配不同屏宽） */

page {
  background: #f2f5fa;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2a44;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------------- 顶部渐变区 ---------------- */
.hero {
  background: linear-gradient(135deg, #3f6fe8 0%, #5b8cf5 55%, #78b0fa 100%);
  padding: 52rpx 32rpx 40rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  box-shadow: 0 12rpx 30rpx rgba(63, 111, 232, 0.22);
  color: #fff;
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.app-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.app-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  opacity: 0.78;
  letter-spacing: 1rpx;
}

.hero-icon {
  font-size: 62rpx;
  opacity: 0.6;
  line-height: 1;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 10rpx 0 26rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 42rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 60, 150, 0.14);
}

.search-icon {
  font-size: 38rpx;
  color: #8b9ac2;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 27rpx;
  color: #22304f;
}

.search-placeholder {
  color: #a6b1c8;
}

.search-btn {
  padding: 0 34rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 33rpx;
  background: linear-gradient(135deg, #4a7cf0, #6aa0f8);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}

/* 快捷城市 */
.quick-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.quick-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-right: 18rpx;
}

.quick-chip {
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 26rpx;
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.quick-chip-on {
  background: #fff;
  color: #3f6fe8;
  border-color: #fff;
  font-weight: 600;
}

/* 数据源切换 */
.mode-row {
  display: flex;
  margin-top: 28rpx;
  padding: 5rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  align-self: flex-start;
  width: 300rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  padding: 9rpx 0;
  font-size: 22rpx;
  border-radius: 24rpx;
  opacity: 0.82;
}

.mode-on {
  background: #fff;
  color: #3f6fe8;
  font-weight: 600;
  opacity: 1;
}

/* ---------------- 内容区 ---------------- */
.content {
  padding: 0 28rpx;
  margin-top: -8rpx;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-top: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 55, 105, 0.07);
}

/* 当前天气主卡 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.city-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2a44;
}

.province-name {
  font-size: 23rpx;
  color: #8b96ad;
  margin-left: 14rpx;
}

.source-tag {
  font-size: 20rpx;
  padding: 7rpx 18rpx;
  border-radius: 20rpx;
}

.tag-live {
  background: #e8f6ee;
  color: #1c9a5e;
}

.tag-demo {
  background: #fff3e2;
  color: #c47b18;
}

.temp-row {
  display: flex;
  align-items: center;
  margin: 26rpx 0 30rpx;
}

.weather-emoji {
  font-size: 76rpx;
  line-height: 1;
  margin-right: 20rpx;
}

.temp-block {
  display: flex;
  align-items: flex-start;
}

.temp-num {
  font-size: 104rpx;
  font-weight: 300;
  line-height: 1;
  color: #2b5bd7;
  letter-spacing: -4rpx;
}

.temp-unit {
  font-size: 34rpx;
  color: #2b5bd7;
  margin-top: 8rpx;
  margin-left: 4rpx;
}

.temp-side {
  margin-left: auto;
  text-align: right;
}

.condition {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2a3652;
}

.range {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8b96ad;
}

.meta-row {
  display: flex;
  border-top: 1rpx solid #eef1f7;
  padding-top: 26rpx;
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-left: 18rpx;
  border-left: 1rpx solid #eef1f7;
}

.meta-item:first-child {
  padding-left: 0;
  border-left: none;
}

.meta-label {
  font-size: 21rpx;
  color: #9aa5ba;
}

.meta-value {
  font-size: 24rpx;
  color: #33415f;
  margin-top: 8rpx;
  font-weight: 500;
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2a3652;
  margin: 38rpx 0 0 8rpx;
}

/* 未来预报 */
.forecast-card {
  padding: 12rpx 30rpx;
}

.forecast-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f3f8;
  font-size: 24rpx;
}

.forecast-row:last-child {
  border-bottom: none;
}

.f-label {
  width: 88rpx;
  font-weight: 600;
  color: #33415f;
}

.f-emoji {
  width: 60rpx;
  font-size: 34rpx;
}

.f-cond {
  flex: 1;
  color: #55627c;
}

.f-range {
  width: 160rpx;
  text-align: right;
  color: #2b5bd7;
  font-weight: 600;
}

.f-wind {
  display: none;
}

/* 实况 / 指数 / 简介 */
.info-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #3f6fe8;
  margin-bottom: 12rpx;
}

.info-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #5c6880;
}

.info-text.multi {
  white-space: pre-line;
}

.divider {
  height: 1rpx;
  background: #eef1f7;
  margin: 26rpx 0;
}

/* 原始 XML 报文 */
.xml-card {
  padding: 0;
  overflow: hidden;
}

.xml-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
}

.xml-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #33415f;
}

.xml-toggle {
  font-size: 22rpx;
  color: #3f6fe8;
}

.xml-hint {
  display: block;
  padding: 0 32rpx 28rpx;
  font-size: 22rpx;
  color: #9aa5ba;
}

.xml-code {
  display: block;
  padding: 0 32rpx 32rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: #46567a;
  word-break: break-all;
}

/* 状态与页脚 */
.state-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 70rpx 30rpx;
  margin-top: 26rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 55, 105, 0.07);
}

.state-emoji {
  display: block;
  font-size: 60rpx;
  margin-bottom: 18rpx;
}

.state-text {
  font-size: 25rpx;
  color: #8b96ad;
}

.footer {
  text-align: center;
  font-size: 20rpx;
  color: #b3bccd;
  margin: 44rpx 0 10rpx;
}
